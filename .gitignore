# Never commit credentials. ~/.config/secrets.env lives at mode 600 outside
# this repo; this entry is a backstop in case it is ever copied in here.
secrets.env
*.secrets
.env
# Machine/work shell environment, sourced by .zshrc when present.
zshrc/.config/zsh/local.zsh

# The same rule applies to the system config in system/. These files carry
# credentials -- a VLESS server UUID, wifi PSKs in plaintext, an RDP host --
# and INSTALL.md step 7 explains how to carry each one across by hand instead.
system/etc/sing-box/
system/etc/NetworkManager/system-connections/
local-bin/.local/bin/connectvm

# Backups written by system/install.sh, in case anyone runs it from a checkout.
*.bak-*

# Copyrighted sprite art for personal theming only -- never committed. The
# creature-shell surfaces fall back to dashed placeholder slots when these
# files are absent, so a fresh clone still works.
quickshell/.config/quickshell/assets/

# Python bytecode from scripts run in place.
__pycache__/

# Build output from web-ext (signed and unsigned extension packages)
web-ext-artifacts/

# Claude Code: the claude package carries only settings.json, CLAUDE.md,
# commands/, skills/, templates/. Everything else under ~/.claude is state
# (credentials, history, sessions, caches) and must never be tracked.
**/settings.local.json
**/.claude.json
claude/.claude/*
!claude/.claude/settings.json
!claude/.claude/CLAUDE.md
!claude/.claude/commands/
!claude/.claude/skills/
!claude/.claude/templates/

# Mozilla add-on upload id written by web-ext sign. Not config.
.amo-upload-uuid
