# Never commit credentials. ~/.config/secrets.env lives at mode 600 outside
# this repo; this entry is a backstop in case it is ever copied in here.
secrets.env
*.secrets
.env

# The same rule applies to the system config in system/. These files carry
# credentials -- a VLESS server UUID, wifi PSKs in plaintext, an RDP host --
# and INSTALL.md step 7 explains how to carry each one across by hand instead.
system/etc/sing-box/
system/etc/NetworkManager/system-connections/
local-bin/.local/bin/connectvm

# Backups written by system/install.sh, in case anyone runs it from a checkout.
*.bak-*
