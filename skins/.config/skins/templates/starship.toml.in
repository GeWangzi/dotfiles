# @@BANNER@@
# Skin: @@SKIN@@
#
# Edit ~/.config/skins/templates/starship.toml.in, not this file: this one is
# rewritten from that template every time the skin changes, and $STARSHIP_CONFIG
# points here rather than at ~/.config/starship.toml (which is not stowed, and
# should not exist -- starship reads exactly one file and has no include).

"$schema" = "https://starship.rs/config-schema.json"

# The live prompt from the "W4 -- spine + full greeting" handoff (Retro RPG
# launcher concepts #5), section 3:
#
#     ▌ …/dotfiles ⑂ master !2 ?1 █
#
# The spine, the directory, the branch, the dirty counts, then the cursor. No
# caret glyph -- the block cursor is the design's terminal cursor, sitting
# where you type.
#
# The clock is an addition to the handoff, which has no clock on the prompt. It
# sits at the left, immediately after the spine, rather than right-aligned: the
# prompt is a single line and you type at the end of it, so anything pushed to
# the right edge would have the command typed straight past it. At the left it
# also stamps every block in the scrollback with the time the command was
# entered, which is the useful half of having a clock here at all.
#
# There is still no battery: the handoff puts HP in the greeting and says there
# is no separate battery indicator anywhere. To add one, append `$fill$battery`
# and restore the [fill] and [battery] sections from git history.
#
# The rest of the block -- the status-coloured row that closes it -- is
# ~/.config/zsh/rpg-spine.zsh, because a prompt cannot colour a spine by an
# exit status it has not seen yet.
#
# add_newline is off: the shell-owned lines then stack directly against each
# other and the gutter reads as one column rather than as detached stubs. It is
# the closest a terminal gets to the mock's full-height spine.
#
# The previous Ember prompt is kept as ~/.config/starship-ember.toml, which is
# still stowed and still hand-written. To go back, point $STARSHIP_CONFIG at it
# in ~/.zshrc instead of at the generated file.

add_newline = false

format = "[▌ ](fg:live)$time$directory$git_branch$git_status$git_state"

palette = "battle"

# The handoff's "Design Tokens", mapped onto the active skin rather than
# copied out of the design. skinctl's prompt_colors() is where each of these
# is decided and why; the short version is that everything structural follows
# the skin and the two status colours (ok, warn) stay pinned to the fixed
# thresholds, because a status that changes colour with the theme stops
# reading as a status.
[palettes.battle]
field = "@@field@@"  # background
panel = "@@panel@@"
panel_alt = "@@panel_alt@@"
rule = "@@rule@@"  # inner / track / rule
frame = "@@frame@@"  # frame / bright text
brightest = "@@brightest@@"
body = "@@body@@"
dim = "@@dim@@"
dimmest = "@@dimmest@@"
accent = "@@accent@@"
live = "@@live@@"  # the creature's primary type hue; the live spine
secondary = "@@secondary@@"
ok = "@@ok@@"  # git branch -- fixed threshold
warn = "@@warn@@"  # dirty counts -- fixed threshold
yellow = "@@yellow@@"
critical = "@@critical@@"
info = "@@info@@"  # EXP
mint = "@@mint@@"

[directory]
style = "fg:accent"
format = "[$path]($style)[$read_only]($read_only_style) "
truncation_length = 1
truncation_symbol = "…/"
truncate_to_repo = false
read_only = " RO"
read_only_style = "bold fg:critical"

# U+2442, the fork glyph the design draws. Only Adwaita Mono and FreeMono carry
# it on this machine, so kitty renders it out of the fallback rather than out
# of DejaVu. Swap to the Nerd Font "" if that fallback ever looks wrong.
[git_branch]
symbol = "⑂ "
style = "fg:ok"
format = "[$symbol$branch]($style) "
truncation_length = 24
truncation_symbol = "…"

# "!2 ?1". Counters render only when they are real -- a clean repo shows
# nothing at all, which is what the handoff asks for.
[git_status]
style = "fg:warn"
format = "([$all_status$ahead_behind]($style))"
conflicted = "×${count} "
ahead = "↑${count} "
behind = "↓${count} "
diverged = "↕${ahead_count}${behind_count} "
up_to_date = ""
untracked = "?${count} "
stashed = "≡${count} "
modified = "!${count} "
staged = "+${count} "
renamed = "»${count} "
deleted = "✘${count} "

# Mid-operation state: rebase, merge, bisect. Bold, so kitty draws it in
# Silkscreen -- these are labels in the design, not body text.
[git_state]
style = "bold fg:critical"
format = "[$state( $progress_current/$progress_total)]($style) "
rebase = "REBASE"
merge = "MERGE"
revert = "REVERT"
cherry_pick = "CHERRY-PICK"
bisect = "BISECT"
am = "AM"
am_or_rebase = "AM/REBASE"

# Dim, so it sits behind the directory rather than competing with it.
[time]
disabled = false
time_format = "%R"
format = "[$time ]($style)"
style = "fg:dim"
