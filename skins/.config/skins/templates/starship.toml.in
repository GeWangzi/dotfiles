# @@BANNER@@
# Skin: @@SKIN@@
#
# Edit ~/.config/skins/templates/starship.toml.in, not this file: this one is
# rewritten from that template every time the skin changes, and $STARSHIP_CONFIG
# points here rather than at ~/.config/starship.toml (which is not stowed, and
# should not exist -- starship reads exactly one file and has no include).

"$schema" = "https://starship.rs/config-schema.json"

# Plain prompt (2026-08-25). The creature-era terminal -- the W4 spine, the
# closing status row (rpg-spine.zsh) and the shell greeting (rpg-greet) -- is
# gone; all three live in git history. What those surfaces carried that was
# actually useful moved into the prompt itself, as starship's own modules:
#
#     17:42 ~/dotfiles master !2 ?1 ❯
#
# and after a failed or slow command:
#
#     17:42 ~/dotfiles master 12.8s 101 ❯
#
# The exit code renders only on failure, the duration only above 2s, and the
# caret itself flips from ok-green to critical-red on failure -- the same two
# fixed threshold colours the spine used, for the same reason: a status colour
# that moves with the theme stops reading as a status. Everything structural
# still follows the skin through the palette below, which skinctl fills in.

add_newline = true

format = "$time$directory$git_branch$git_status$git_state$cmd_duration$status$character"

palette = "skin"

# skinctl's prompt_colors() is where each of these is decided and why. The
# short version: structural colours follow the skin; ok / warn / critical are
# pinned to the fixed thresholds.
[palettes.skin]
field = "@@field@@"  # background
panel = "@@panel@@"
panel_alt = "@@panel_alt@@"
rule = "@@rule@@"  # inner / track / rule
frame = "@@frame@@"  # frame / bright text
brightest = "@@brightest@@"
body = "@@body@@"
dim = "@@dim@@"
dimmest = "@@dimmest@@"
accent = "@@accent@@"
live = "@@live@@"
secondary = "@@secondary@@"
ok = "@@ok@@"  # git branch, success caret -- fixed threshold
warn = "@@warn@@"  # dirty counts -- fixed threshold
yellow = "@@yellow@@"
critical = "@@critical@@"  # exit code, failure caret -- fixed threshold
info = "@@info@@"
mint = "@@mint@@"

[directory]
style = "fg:accent"
format = "[$path]($style)[$read_only]($read_only_style) "
truncation_length = 3
truncation_symbol = "…/"
truncate_to_repo = true
read_only = " RO"
read_only_style = "bold fg:critical"

# Branch as plain text, no glyph: the ⑂ of the creature prompt rendered out
# of a fallback font (only Adwaita Mono and FreeMono carry U+2442 here) and a
# plain word reads fine without it.
[git_branch]
symbol = ""
style = "fg:ok"
format = "[$branch]($style) "
truncation_length = 24
truncation_symbol = "…"

# "!2 ?1". Counters render only when they are real -- a clean repo shows
# nothing at all.
[git_status]
style = "fg:warn"
format = "([$all_status$ahead_behind]($style))"
conflicted = "×${count} "
ahead = "↑${count} "
behind = "↓${count} "
diverged = "↕${ahead_count}${behind_count} "
up_to_date = ""
untracked = "?${count} "
stashed = "≡${count} "
modified = "!${count} "
staged = "+${count} "
renamed = "»${count} "
deleted = "✘${count} "

# Mid-operation state: rebase, merge, bisect.
[git_state]
style = "bold fg:critical"
format = "[$state( $progress_current/$progress_total)]($style) "
rebase = "REBASE"
merge = "MERGE"
revert = "REVERT"
cherry_pick = "CHERRY-PICK"
bisect = "BISECT"
am = "AM"
am_or_rebase = "AM/REBASE"

# Dim, so it sits behind the directory rather than competing with it. Stamps
# every command in the scrollback with the time it was entered.
[time]
disabled = false
time_format = "%R"
format = "[$time ]($style)"
style = "fg:dim"

# Replaces the closing row's duration. min_time is starship's 2s default --
# above the spine's old 100ms on purpose, so the line only appears when the
# number is worth reading.
[cmd_duration]
min_time = 2000
style = "fg:dim"
format = "[$duration ]($style)"

# Replaces the closing row's exit code. Renders only on failure.
[status]
disabled = false
style = "bold fg:critical"
format = "[$status ]($style)"

# The caret carries the last exit status, like the spine did.
[character]
success_symbol = "[❯](fg:ok)"
error_symbol = "[❯](fg:critical)"
