# Fcitx 5, the input method daemon (pinyin and mozc). Started the same way as
# hyprpolkitagent and hyprsunset: enabled into graphical-session.target.wants,
# which hyprland-session.target pulls in. Hyprland imports WAYLAND_DISPLAY and
# DISPLAY into the systemd user environment, so this one process serves
# Wayland clients over input-method-v2, Qt5 over D-Bus, and Xwayland clients
# over XIM. The package ships no unit of its own, only an XDG autostart file
# that Hyprland ignores.
#
# --replace: the package also ships a D-Bus activation file, so a Qt5 client
# that starts first can spawn its own fcitx5; this instance takes over instead
# of exiting with "already running" and tripping Restart=on-failure.
#
# Enable once: systemctl --user enable --now fcitx5.service

[Unit]
Description=Fcitx 5 input method
Documentation=https://fcitx-im.org/wiki/Using_Fcitx_5_on_Wayland
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/fcitx5 --replace
Slice=session.slice
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
