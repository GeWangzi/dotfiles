{
  "position": "top",
  "modules-left": ["clock"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["network", "bluetooth", "wireplumber", "battery"],
  "clock": {
    "format": "{:%a %d %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-icons": {
      "default": ["󰂎","󱊡","󱊢","󱊣"],
      //"charging": ["󰢟 ", "󰢜 ", "󰂆 ", "󰂇 ", "󰂈 ", "󰢝 ", "󰂉 ", "󰢞 ", "󰂊 ", "󰂋 ", "󰂅 "],
      "plugged": ["󰂄"]
    },
    "tooltip-format": "{time}",
  },
  "network": {
    "interval": 5,
    "format-wifi": "{icon} {essid}",
    "format-ethernet": "<span size='13000' foreground='#f5e0dc'>󰤭</span> Connected",
    "format-disconnected": "  Disconnected",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "Signal: {signalStrength}% ",
    "on-click": "nm-connection-editor"
  },

  // blueman-manager used to hang off the audio module's on-click, which meant
  // clicking the volume readout opened a Bluetooth window. It belongs here.
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "blueman-manager"
  },

  // Was the "pulseaudio" module. This machine runs PipeWire with WirePlumber
  // as its session manager, so the wireplumber module talks to the actual
  // sink manager instead of going through the PulseAudio compatibility layer.
  // Same wpctl that the volume keybinds in hyprland.lua use.
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": ["", "", " "],
    // Cap at 100 so a stray scroll cannot push the sink into software boost.
    "max-volume": 100,
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{node_name}"
  }

  // custom/power removed: it was a single unconfirmed click bound to
  // `shutdown now`, with no prompt and nothing to cancel it. Lock is
  // SUPER+L; shut down from a terminal.
}
