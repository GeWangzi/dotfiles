{
  "manifest_version": 3,
  "name": "YouTube Ad Speed Skipper",
  "version": "1.7.0",
  "description": "Plays YouTube ads at high speed, muted, and clicks the skip button the moment it appears.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ads skipped"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-ad-speedskip@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
