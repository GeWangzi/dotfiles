#!/usr/bin/env bash
# Cycle the ASUS platform profile and show a notification.
# Bound to SUPER+F5 in hyprland.lua.
set -euo pipefail

NEW=$(sudo -n /usr/local/bin/power-profile-cycle 2>/dev/null) || {
    notify-send -u critical "Power profile" "Failed: helper not installed or sudoers rule missing"
    exit 1
}

case "$NEW" in
    quiet)       ICON="battery-full-symbolic";  BODY="Quiet — fans off at idle, lower power limits" ;;
    balanced)    ICON="battery-good-symbolic";  BODY="Balanced — default power and fan curve" ;;
    performance) ICON="battery-caution-symbolic"; BODY="Performance — max power, aggressive fans" ;;
    *)           ICON="dialog-information";     BODY="$NEW" ;;
esac

notify-send -i "$ICON" -t 2500 "Power profile: $NEW" "$BODY"
