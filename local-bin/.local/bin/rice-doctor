#!/bin/sh
# rice-doctor -- restart the Quickshell shell and verify it came up clean.
#
# QML errors only surface at runtime, so a typo saved today is a black shell
# at the next login. Run this after every shell edit, before logging out.
#
# This is also the safe way to restart the shell by hand: `qs kill` leaves
# stale instances behind and every later IPC call hangs on them, so the
# restart is pkill -x. SUPER+SHIFT+R does the same restart without the
# verdict.

fail=0
ok()   { printf 'ok    %s\n' "$1"; }
warn() { printf 'WARN  %s\n' "$1"; }
bad()  { printf 'FAIL  %s\n' "$1"; fail=1; }

# --- preconditions the shell needs before it is worth starting -------------

skinjson="${XDG_STATE_HOME:-$HOME/.local/state}/skins/skin.json"
if [ -r "$skinjson" ]; then
    ok "skin.json present"
else
    bad "skin.json missing -- run: skinctl generate"
fi

if fc-list 2>/dev/null | grep -qi cozettevector; then
    ok "CozetteVector installed"
else
    warn "CozetteVector not in the font cache -- hyprlock falls back (fc-cache -f)"
fi

if fc-list 2>/dev/null | grep -qi silkscreen; then
    ok "Silkscreen installed"
else
    warn "Silkscreen not in the font cache -- shell fallback face missing (fc-cache -f)"
fi

# The skin's own face (font_label / font_body). Adwaita Sans comes from the
# adwaita-fonts package, not this repo.
if fc-list 2>/dev/null | grep -qi "Adwaita Sans"; then
    ok "Adwaita Sans installed"
else
    warn "Adwaita Sans not in the font cache -- Dream Land falls back (pacman -S adwaita-fonts)"
fi

# GTK applications are themed by the generated gtk.css, but only the GTK4 half
# of that works on its own: GTK3 needs adw-gtk-theme, which is what reads the
# libadwaita colour names the stylesheet defines. Without it, stock Adwaita
# ignores most of them and file dialogs stay grey.
if [ -d /usr/share/themes/adw-gtk3-dark ]; then
    ok "adw-gtk-theme installed"
else
    warn "adw-gtk-theme missing -- GTK3 apps ignore the skin (pacman -S adw-gtk-theme)"
fi

if [ -r "$HOME/.config/gtk-3.0/gtk.css" ] && [ -r "$HOME/.config/gtk-4.0/gtk.css" ]; then
    ok "GTK stylesheets present"
else
    bad "GTK stylesheets missing -- run: skinctl generate"
fi

# The prompt and the two zsh surfaces are generated per skin as well. A stale
# ~/.config/starship.toml is worth calling out separately: $STARSHIP_CONFIG
# points into the state directory now, so a leftover file there is not read,
# and editing it looks like a prompt that refuses to change.
skindir="${XDG_STATE_HOME:-$HOME/.local/state}/skins"
if [ -r "$skindir/starship.toml" ] && [ -r "$skindir/skin.sh" ]; then
    ok "prompt and shell colours generated"
else
    bad "starship.toml or skin.sh missing -- run: skinctl generate"
fi

if [ -e "$HOME/.config/starship.toml" ]; then
    warn "~/.config/starship.toml is stale -- \$STARSHIP_CONFIG reads $skindir/starship.toml (rm it)"
fi

# kitty's body face since the Console redesign (2026-08-24), vendored in the
# `fonts` stow package. Unlike the two above, a miss here is not a graceful
# fallback: kitty asks fontconfig, fontconfig answers Noto Sans CJK, and the
# whole terminal grid is sized from a proportional face. fc-match rather
# than fc-list, because that substitution is exactly what has to be caught.
if [ "$(fc-match -f '%{family}' 'IBM Plex Mono' 2>/dev/null)" = "IBM Plex Mono" ]; then
    ok "IBM Plex Mono installed"
else
    bad "IBM Plex Mono missing -- kitty will size its grid from Noto Sans CJK (stow fonts; fc-cache -f)"
fi

# --- restart ---------------------------------------------------------------

pkill -x qs 2>/dev/null && sleep 0.5
qs -d >/dev/null 2>&1
sleep 3

if pgrep -x qs >/dev/null; then
    ok "qs process alive 3s after start"
else
    bad "qs is not running -- start it in the foreground to see why: qs"
    echo "VERDICT: FAIL"
    exit 1
fi

if qs ipc show >/dev/null 2>&1; then
    ok "IPC answering"
else
    bad "IPC not answering (stale instance? pkill -x qs and retry)"
fi

# --- read the new instance's log -------------------------------------------
# by-id/ keeps logs from dead instances too; the newest directory is the one
# just started. The log is not plain text, hence strings.

byid="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/quickshell/by-id"
inst=$(ls -t "$byid" 2>/dev/null | head -1)
if [ -z "$inst" ]; then
    bad "no instance directory under $byid"
else
    errs=$(strings "$byid/$inst/log.qslog" 2>/dev/null | grep -E 'ERROR|CRITICAL')
    if [ -n "$errs" ]; then
        bad "errors in the shell log ($inst):"
        printf '%s\n' "$errs" | head -8 | sed 's/^/      /'
    else
        ok "shell log clean ($inst)"
    fi
fi

if [ "$fail" -eq 0 ]; then
    echo "VERDICT: PASS"
else
    echo "VERDICT: FAIL"
fi
exit "$fail"
