#!/usr/bin/env python3
"""Build and install the rpg-cursors pixel cursor theme.

Every shape is 12x12 pixel art drawn here as fill-only text maps (or tiny
generators for the geometric ones); a one-pixel dark outline is added
automatically around every filled cell, then the art is upscaled
nearest-neighbour to 24/36/48 so the cursor stays crisp at any size a
client asks for. The files are written in the Xcursor binary format
directly -- xcursorgen is not installed and this needs nothing beyond
python.

Palette matches the desktop: warm-white fill, crust outline, ember red for
the wait-cursor sand and the not-allowed ring, so the theme reads on every
skin without being regenerated per skin.

Installs to ~/.local/share/icons/rpg-cursors (a per-user font-path, no
root). Missing shapes fall back to Adwaita via index.theme Inherits.
Run once after cloning; nothing regenerates it automatically.
"""

import os
import shutil
import struct

K = (0x16, 0x12, 0x15)   # outline: crust
W = (0xED, 0xE0, 0xDC)   # fill: warm white
A = (0xF9, 0x6B, 0x69)   # accent: ember red

BASE = 12
SCALES = (2, 3, 4)       # nominal sizes 24, 36, 48

THEME = "rpg-cursors"
DEST = os.path.expanduser("~/.local/share/icons/" + THEME)


def grid():
    return [[None] * BASE for _ in range(BASE)]


def parse(art):
    g = grid()
    for r, line in enumerate(art.strip("\n").split("\n")):
        for c, ch in enumerate(line):
            if ch == "w":
                g[r][c] = W
            elif ch == "a":
                g[r][c] = A
    return g


def outline(g):
    # Any empty cell touching fill (8-neighbourhood) becomes outline. Only
    # W/A trigger it, so freshly painted K never spreads further.
    for r in range(BASE):
        for c in range(BASE):
            if g[r][c] is None:
                for dr in (-1, 0, 1):
                    for dc in (-1, 0, 1):
                        rr, cc = r + dr, c + dc
                        if 0 <= rr < BASE and 0 <= cc < BASE and g[rr][cc] in (W, A):
                            g[r][c] = K
    return g


def transpose(g):
    return [[g[c][r] for c in range(BASE)] for r in range(BASE)]


# --- the geometric shapes ---------------------------------------------------

def diagonal(mirror):
    """Double-headed diagonal arrow, NW-SE; mirrored gives NE-SW."""
    g = grid()
    for r in range(BASE):
        for c0 in range(BASE):
            head_a = r + c0 <= 4
            head_b = (BASE - 1 - r) + (BASE - 1 - c0) <= 4
            shaft = abs(r - c0) <= 1
            if head_a or head_b or shaft:
                c = BASE - 1 - c0 if mirror else c0
                g[r][c] = W
    return g


def fleur():
    """Four-way move arrow."""
    g = grid()
    for r in range(BASE):
        for c in range(BASE):
            fill = (5 <= c <= 6 and 1 <= r <= 10) or (5 <= r <= 6 and 1 <= c <= 10)
            fill = fill or (r <= 2 and abs(2 * c - 11) <= 2 * r + 1)
            fill = fill or (r >= 9 and abs(2 * c - 11) <= 2 * (11 - r) + 1)
            fill = fill or (c <= 2 and abs(2 * r - 11) <= 2 * c + 1)
            fill = fill or (c >= 9 and abs(2 * r - 11) <= 2 * (11 - c) + 1)
            if fill:
                g[r][c] = W
    return g


def not_allowed():
    """Red ring with a slash."""
    g = grid()
    for r in range(BASE):
        for c in range(BASE):
            d = ((r - 5.5) ** 2 + (c - 5.5) ** 2) ** 0.5
            if 3.6 <= d <= 5.4:
                g[r][c] = A
            elif d < 3.6 and abs(r - c) <= 0.9:
                g[r][c] = A
    return g


# --- the drawn shapes: fill maps + base-grid hotspot ------------------------

SHAPES = {
    "left_ptr": (parse("""
w...........
ww..........
www.........
wwww........
wwwww.......
wwwwww......
wwwwwww.....
wwwwwwww....
wwwww.......
ww.ww.......
...ww.......
............
"""), (0, 0)),

    "hand2": (parse("""
...ww.......
...ww.......
...ww.......
...ww.w.....
...wwwww.w..
.w.wwwwwww..
.wwwwwwwww..
.wwwwwwwww..
..wwwwwwww..
..wwwwwww...
...wwwwww...
............
"""), (3, 0)),

    "xterm": (parse("""
..wwwww.....
....w.......
....w.......
....w.......
....w.......
....w.......
....w.......
....w.......
....w.......
....w.......
....w.......
..wwwww.....
"""), (4, 5)),

    "crosshair": (parse("""
.....w......
.....w......
.....w......
.....w......
.....w......
wwwwwwwwwww.
.....w......
.....w......
.....w......
.....w......
.....w......
............
"""), (5, 5)),

    "watch": (parse("""
.wwwwwwww...
..w....w....
..w.aa.w....
...waaw.....
....ww......
....ww......
...w..w.....
..w.aa.w....
..waaaaw....
.wwwwwwww...
............
............
"""), (4, 4)),

    "sb_h_double_arrow": (parse("""
............
............
............
..w......w..
.ww......ww.
wwwwwwwwwwww
.ww......ww.
..w......w..
............
............
............
............
"""), (5, 5)),
}

SHAPES["sb_v_double_arrow"] = (transpose(SHAPES["sb_h_double_arrow"][0]), (5, 5))
SHAPES["bottom_right_corner"] = (diagonal(False), (5, 5))
SHAPES["bottom_left_corner"] = (diagonal(True), (5, 5))
SHAPES["fleur"] = (fleur(), (5, 5))
SHAPES["not-allowed"] = (not_allowed(), (5, 5))

# Alias -> canonical. Covers the GTK/CSS names, the legacy X names and the
# corner/side variants; anything not here falls through to Adwaita.
ALIASES = {
    "default": "left_ptr", "arrow": "left_ptr", "top_left_arrow": "left_ptr",
    "context-menu": "left_ptr",
    "pointer": "hand2", "hand1": "hand2", "pointing_hand": "hand2",
    "grab": "hand2", "openhand": "hand2",
    "grabbing": "fleur", "closedhand": "fleur", "all-scroll": "fleur",
    "move": "fleur", "size_all": "fleur", "dnd-move": "fleur",
    "text": "xterm", "ibeam": "xterm",
    "cross": "crosshair", "tcross": "crosshair",
    "wait": "watch", "progress": "watch", "left_ptr_watch": "watch",
    "half-busy": "watch",
    "ew-resize": "sb_h_double_arrow", "h_double_arrow": "sb_h_double_arrow",
    "e-resize": "sb_h_double_arrow", "w-resize": "sb_h_double_arrow",
    "left_side": "sb_h_double_arrow", "right_side": "sb_h_double_arrow",
    "col-resize": "sb_h_double_arrow", "split_h": "sb_h_double_arrow",
    "ns-resize": "sb_v_double_arrow", "v_double_arrow": "sb_v_double_arrow",
    "n-resize": "sb_v_double_arrow", "s-resize": "sb_v_double_arrow",
    "top_side": "sb_v_double_arrow", "bottom_side": "sb_v_double_arrow",
    "row-resize": "sb_v_double_arrow", "split_v": "sb_v_double_arrow",
    "nwse-resize": "bottom_right_corner", "top_left_corner": "bottom_right_corner",
    "se-resize": "bottom_right_corner", "nw-resize": "bottom_right_corner",
    "size_fdiag": "bottom_right_corner",
    "nesw-resize": "bottom_left_corner", "top_right_corner": "bottom_left_corner",
    "sw-resize": "bottom_left_corner", "ne-resize": "bottom_left_corner",
    "size_bdiag": "bottom_left_corner",
    "forbidden": "not-allowed", "no-drop": "not-allowed",
    "crossed_circle": "not-allowed", "dnd-no-drop": "not-allowed",
    "circle": "not-allowed",
}


# --- Xcursor binary writer --------------------------------------------------
# https://www.x.org/releases/current/doc/man/man3/Xcursor.3.xhtml
# All fields little-endian u32. One image chunk per size.

def xcursor(images):
    """images: list of (nominal, width, height, xhot, yhot, argb_rows)"""
    ntoc = len(images)
    out = struct.pack("<4sIII", b"Xcur", 16, 0x10000, ntoc)
    pos = 16 + ntoc * 12
    toc, body = b"", b""
    for nominal, w, h, xh, yh, pixels in images:
        toc += struct.pack("<III", 0xFFFD0002, nominal, pos)
        chunk = struct.pack("<IIIIIIIII", 36, 0xFFFD0002, nominal, 1,
                            w, h, xh, yh, 50) + pixels
        body += chunk
        pos += len(chunk)
    return out + toc + body


def render(g, hot):
    images = []
    for s in SCALES:
        size = BASE * s
        px = bytearray()
        for r in range(size):
            for c in range(size):
                cell = g[r // s][c // s]
                if cell is None:
                    px += b"\x00\x00\x00\x00"
                else:
                    rr, gg, bb = cell
                    px += struct.pack("<I", 0xFF000000 | (rr << 16) | (gg << 8) | bb)
        images.append((size, size, size, hot[0] * s + s // 2, hot[1] * s + s // 2, bytes(px)))
    return xcursor(images)


def main():
    cdir = os.path.join(DEST, "cursors")
    shutil.rmtree(DEST, ignore_errors=True)
    os.makedirs(cdir)

    for name, (g, hot) in SHAPES.items():
        data = render(outline([row[:] for row in g]), hot)
        with open(os.path.join(cdir, name), "wb") as f:
            f.write(data)

    for alias, target in ALIASES.items():
        os.symlink(target, os.path.join(cdir, alias))

    with open(os.path.join(DEST, "index.theme"), "w") as f:
        f.write("[Icon Theme]\n"
                "Name=" + THEME + "\n"
                "Comment=12px pixel-art cursors for the creature shell\n"
                "Inherits=Adwaita\n")

    print("installed " + DEST + ": "
          + str(len(SHAPES)) + " shapes, " + str(len(ALIASES)) + " aliases")


if __name__ == "__main__":
    main()
