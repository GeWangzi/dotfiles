#!/usr/bin/env python3
"""Print the ACPI platform profile once, then again on every change.

Fn+F5 is handled inside the asus-wmi driver, so the profile changes with no
key event and no D-Bus signal for the shell to hear. What the kernel does
emit is sysfs_notify on /sys/firmware/acpi/platform_profile, which shows up
as POLLPRI on an open fd -- not as inotify, so FileView.watchChanges cannot
see it. This blocks in poll(2) and costs nothing between changes. The shell
(SysState.qml) runs it for the life of the session and reads one word per
line: quiet, balanced or performance.
"""

import os
import select
import sys

PATH = "/sys/firmware/acpi/platform_profile"


def main() -> int:
    try:
        fd = os.open(PATH, os.O_RDONLY)
    except OSError as e:
        print(f"platform-profile-watch: {PATH}: {e.strerror}", file=sys.stderr)
        return 1
    poller = select.poll()
    poller.register(fd, select.POLLPRI | select.POLLERR)
    try:
        while True:
            os.lseek(fd, 0, os.SEEK_SET)
            print(os.read(fd, 64).decode().strip(), flush=True)
            poller.poll()
    except BrokenPipeError:
        return 0
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
